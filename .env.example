# Public Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only Supabase credential. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (optional - Resend)
RESEND_API_KEY=your-resend-api-key
ENQUIRY_TO_EMAIL=admin@samiraqglobal.com

# Set this to the deployed Netlify URL when available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
